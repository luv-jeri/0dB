# Workers static assets: https://developers.cloudflare.com/workers/static-assets/headers/
# Inline scripts include the pre-paint theme and route-specific Next flight payloads.
# Their global hashes exceed the 2,000-character line limit; per-page rules exceed 100.
# Match 000h's static CSP with 0dB's reporting API and Turnstile, without analytics.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://feedback-0db.cojeev.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate

# The original specimen uses Google Fonts and esm.sh. Keep those origins here only.
/specimen/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://esm.sh; frame-src 'none'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/r/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate

/r/*.json
  Content-Type: application/json; charset=utf-8

/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
