  ],\n      [\n        \"L\",\n        14.97,\n        2.97\n      ],\n      [\n        \"L\",\n        15.44,\n        3.36\n      ],\n      [\n        \"L\",\n        15.85,\n        3.81\n      ],\n      [\n        \"L\",\n        16.21,\n        4.3\n      ],\n      [\n        \"L\",\n        16.51,\n        4.84\n      ],\n      [\n        \"L\",\n        16.74,\n        5.41\n      ],\n      [\n        \"L\",\n        16.9,\n        6\n      ]\n    ]\n  ]\n}\n\nfunction SignUnlockDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignUnlockDots, shape }\n",
