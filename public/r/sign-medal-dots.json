],\n      [\n        \"L\",\n        18.88,\n        2.2\n      ]\n    ],\n    [\n      [\n        \"M\",\n        8,\n        7\n      ],\n      [\n        \"L\",\n        16,\n        7\n      ]\n    ],\n    [\n      [\n        \"O\",\n        12,\n        17,\n        5,\n        0,\n        360\n      ]\n    ],\n    [\n      [\n        \"M\",\n        12,\n        18\n      ],\n      [\n        \"L\",\n        12,\n        16\n      ]\n    ],\n    [\n      [\n        \"M\",\n        12,\n        16\n      ],\n      [\n        \"L\",\n        11.5,\n        16\n      ]\n    ]\n  ]\n}\n\nfunction SignMedalDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignMedalDots, shape }\n",
