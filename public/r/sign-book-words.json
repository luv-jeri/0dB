\n        4.05,\n        19.99\n      ],\n      [\n        \"L\",\n        4,\n        19.5\n      ],\n      [\n        \"L\",\n        4.05,\n        19.01\n      ],\n      [\n        \"L\",\n        4.19,\n        18.54\n      ],\n      [\n        \"L\",\n        4.42,\n        18.11\n      ],\n      [\n        \"L\",\n        4.73,\n        17.73\n      ],\n      [\n        \"L\",\n        5.11,\n        17.42\n      ],\n      [\n        \"L\",\n        5.54,\n        17.19\n      ],\n      [\n        \"L\",\n        6.01,\n        17.05\n      ],\n      [\n        \"L\",\n        6.5,\n        17\n      ],\n      [\n        \"L\",\n        20,\n        17\n      ]\n    ]\n  ]\n}\n\nfunction SignBookWords(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"words\" {...props} />\n}\n\nexport { SignBookWords, shape }\n",
