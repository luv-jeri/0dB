"O\",\n        12,\n        12,\n        10,\n        0,\n        360\n      ]\n    ]\n  ]\n}\n\nfunction SignSmileWords(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"words\" {...props} />\n}\n\nexport { SignSmileWords, shape }\n",
