    [\n        \"L\",\n        8.2,\n        3.13\n      ],\n      [\n        \"L\",\n        8.44,\n        2.75\n      ],\n      [\n        \"L\",\n        8.75,\n        2.44\n      ],\n      [\n        \"L\",\n        9.13,\n        2.2\n      ],\n      [\n        \"L\",\n        9.55,\n        2.05\n      ],\n      [\n        \"L\",\n        10,\n        2\n      ],\n      [\n        \"L\",\n        14,\n        2\n      ],\n      [\n        \"L\",\n        14.45,\n        2.05\n      ],\n      [\n        \"L\",\n        14.87,\n        2.2\n      ],\n      [\n        \"L\",\n        15.25,\n        2.44\n      ],\n      [\n        \"L\",\n        15.56,\n        2.75\n      ],\n      [\n        \"L\",\n        15.8,\n        3.13\n      ],\n      [\n        \"L\",\n        15.95,\n        3.55\n      ],\n      [\n        \"L\",\n        16,\n        4\n      ],\n      [\n        \"L\",\n        16,\n        6\n      ]\n    ]\n  ]\n}\n\nfunction SignTrashDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignTrashDots, shape }\n",
