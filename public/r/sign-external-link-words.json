n        \"L\",\n        3.75,\n        6.44\n      ],\n      [\n        \"L\",\n        4.13,\n        6.2\n      ],\n      [\n        \"L\",\n        4.55,\n        6.05\n      ],\n      [\n        \"L\",\n        5,\n        6\n      ],\n      [\n        \"L\",\n        11,\n        6\n      ]\n    ]\n  ]\n}\n\nfunction SignExternalLinkWords(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"words\" {...props} />\n}\n\nexport { SignExternalLinkWords, shape }\n",
