      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { Sign, type SignProps } from \"@/components/ui/sign\"\nimport type { SignShape } from \"@/lib/0db/sign-shapes\"\n\nconst shape: SignShape = {\n  \"word\": \"chip\",\n  \"line\": [\n    [\n      [\n        \"M\",\n        12,\n        20\n      ],\n      [\n        \"L\",\n        12,\n        22\n      ]\n    ],\n    [\n      [\n        \"M\",\n        12,\n        2\n      ],\n      [\n        \"L\",\n        12,\n        4\n      ]\n    ],\n    [\n      [\n        \"M\",\n        17,\n        20\n      ],\n      [\n        \"L\",\n        17,\n        22\n      ]\n    ],\n    [\n      [\n        \"M\",\n        17,\n        2\n      ],\n      [\n        \"L\",\n        17,\n        4\n      ]\n    ],\n    [\n      [\n        \"M\",\n        2,\n        12\n      ],\n      [\n        \"L\",\n        4,\n        12\n      ]\n    ],\n    [\n      [\n        \"M\",\n        2,\n        17\n      ],\n      [\n        \"L\",\n        4,\n        17\n      ]\n    ],\n    [\n      [\n        \"M\",\n        2,\n        7\n      ],\n      [\n        \"L\",\n        4,\n        7\n      ]\n    ],\n    [\n      [\n        \"M\",\n        20,\n        12\n      ],\n      [\n        \"L\",\n        22,\n        12\n      ]\n    ],\n    [\n      [\n        \"M\",\n        20,\n        17\n      ],\n      [\n        \"L\",\n        22,\n        17\n      ]\n    ],\n    [\n      [\n        \"M\",\n        20,\n        7\n      ],\n      [\n        \"L\",\n        22,\n        7\n      ]\n    ],\n    [\n      [\n        \"M\",\n        7,\n        20\n      ],\n      [\n        \"L\",\n        7,\n        22\n      ]\n    ],\n    [\n      [\n        \"M\",\n        7,\n        2\n      ],\n      [\n        \"L\",\n        7,\n        4\n      ]\n    ],\n    [\n      [\n        \"M\",\n        6,\n        4\n      ],\n      [\n        \"L\",\n        18,\n        4\n      ]\n    ],\n    [\n      [\n        \"M\",\n        20,\n        6\n      ],\n      [\n        \"L\",\n        20,\n        18\n      ]\n    ],\n    [\n      [\n        \"M\",\n        18,\n        20\n      ],\n      [\n        \"L\",\n        6,\n        20\n      ]\n    ],\n    [\n      [\n        \"M\",\n        4,\n        18\n      ],\n      [\n        \"L\",\n        4,\n        6\n      ]\n    ],\n    [\n      [\n        \"M\",\n        9,\n        8\n      ],\n      [\n        \"L\",\n        15,\n        8\n      ]\n    ],\n    [\n      [\n        \"M\",\n        16,\n        9\n      ],\n      [\n        \"L\",\n        16,\n        15\n      ]\n    ],\n    [\n      [\n        \"M\",\n        15,\n        16\n      ],\n      [\n        \"L\",\n        9,\n        16\n      ]\n    ],\n    [\n      [\n        \"M\",\n        8,\n        15\n      ],\n      [\n        \"L\",\n        8,\n        9\n      ]\n    ]\n  ]\n}\n\nfunction SignCpuDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignCpuDots, shape }\n",
