        16.06\n      ],\n      [\n        \"L\",\n        5.74,\n        15.65\n      ],\n      [\n        \"L\",\n        5.44,\n        15.33\n      ],\n      [\n        \"L\",\n        5.05,\n        15.1\n      ],\n      [\n        \"L\",\n        4.61,\n        15\n      ],\n      [\n        \"L\",\n        4.17,\n        15.04\n      ],\n      [\n        \"L\",\n        3.75,\n        15.2\n      ],\n      [\n        \"L\",\n        3.4,\n        15.48\n      ]\n    ]\n  ]\n}\n\nfunction SignListOrderedDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignListOrderedDots, shape }\n",
