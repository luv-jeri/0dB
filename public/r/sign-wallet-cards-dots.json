     11\n      ],\n      [\n        \"L\",\n        21,\n        11\n      ]\n    ],\n    [\n      [\n        \"M\",\n        3,\n        7\n      ],\n      [\n        \"L\",\n        21,\n        7\n      ]\n    ],\n    [\n      [\n        \"M\",\n        5,\n        3\n      ],\n      [\n        \"L\",\n        19,\n        3\n      ]\n    ],\n    [\n      [\n        \"M\",\n        21,\n        5\n      ],\n      [\n        \"L\",\n        21,\n        19\n      ]\n    ],\n    [\n      [\n        \"M\",\n        19,\n        21\n      ],\n      [\n        \"L\",\n        5,\n        21\n      ]\n    ],\n    [\n      [\n        \"M\",\n        3,\n        19\n      ],\n      [\n        \"L\",\n        3,\n        5\n      ]\n    ]\n  ]\n}\n\nfunction SignWalletCardsDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignWalletCardsDots, shape }\n",
