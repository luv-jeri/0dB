        13.24,\n        17.83\n      ],\n      [\n        \"L\",\n        13.83,\n        17.92\n      ],\n      [\n        \"L\",\n        14.41,\n        17.98\n      ],\n      [\n        \"L\",\n        15,\n        18\n      ]\n    ]\n  ]\n}\n\nfunction SignGitMergeDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignGitMergeDots, shape }\n",
