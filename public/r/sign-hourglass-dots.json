    7.59\n      ],\n      [\n        \"L\",\n        16.66,\n        7.28\n      ],\n      [\n        \"L\",\n        16.85,\n        6.94\n      ],\n      [\n        \"L\",\n        16.96,\n        6.56\n      ],\n      [\n        \"L\",\n        17,\n        6.17\n      ],\n      [\n        \"L\",\n        17,\n        2\n      ]\n    ]\n  ]\n}\n\nfunction SignHourglassDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignHourglassDots, shape }\n",
