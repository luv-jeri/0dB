      [\n        \"M\",\n        4,\n        20\n      ],\n      [\n        \"L\",\n        20,\n        20\n      ]\n    ]\n  ]\n}\n\nfunction SignUnderlineDots(props: Omit<SignProps, \"shape\" | \"variant\">) {\n  return <Sign shape={shape} variant=\"dots\" {...props} />\n}\n\nexport { SignUnderlineDots, shape }\n",
